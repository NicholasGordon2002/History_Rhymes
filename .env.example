# .env.example — copy to .env and fill in your keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — YouTube publishing and analytics (OAuth 2.0)
YOUTUBE_CLIENT_ID=your-youtube-client-id-here
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret-here
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token-here

# Optional — production TTS backends
TTS_API_KEY=your-tts-api-key-here

# Optional — licensed stock image library
STOCK_LIBRARY_API_KEY=your-stock-library-api-key-here

# Optional — pipeline tuning
MAX_TOPICS=3
COMPOSE_PROJECT_NAME=history-rhymes
